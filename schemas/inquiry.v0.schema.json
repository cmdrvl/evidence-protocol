{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "budget": {
      "$ref": "#/$defs/budget"
    },
    "completion": {
      "additionalProperties": false,
      "properties": {
        "acceptable_unknowns": {
          "items": {
            "enum": [
              "evidence_missing",
              "human_judgment_required",
              "key_family_uncovered"
            ],
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "allow_operational_unknowns": {
          "type": "boolean"
        },
        "require_every_subject_accounted": {
          "type": "boolean"
        }
      },
      "required": [
        "acceptable_unknowns",
        "allow_operational_unknowns",
        "require_every_subject_accounted"
      ],
      "type": "object"
    },
    "identity_target": {
      "additionalProperties": false,
      "properties": {
        "allow_new_key_families": {
          "type": "boolean"
        },
        "anchor_families": {
          "items": {
            "$ref": "#/$defs/name"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "entity_grains": {
          "items": {
            "$ref": "#/$defs/name"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "key_families": {
          "items": {
            "$ref": "#/$defs/name"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "optimization": {
          "$ref": "#/$defs/name"
        },
        "temporal": {
          "$ref": "#/$defs/name"
        }
      },
      "required": [
        "allow_new_key_families",
        "anchor_families",
        "entity_grains",
        "key_families",
        "optimization",
        "temporal"
      ],
      "type": "object"
    },
    "lenses": {
      "additionalProperties": false,
      "properties": {
        "policy": {
          "minLength": 1,
          "type": "string"
        },
        "profile": {
          "minLength": 1,
          "type": "string"
        },
        "registry": {
          "$ref": "#/$defs/blake3Hash"
        }
      },
      "required": [
        "policy",
        "profile",
        "registry"
      ],
      "type": "object"
    },
    "output": {
      "$ref": "#/$defs/output"
    },
    "question": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "additionalProperties": false,
          "properties": {
            "from": {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "type": "string"
            },
            "to": {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "type": "string"
            }
          },
          "required": [
            "from",
            "to"
          ],
          "type": "object"
        },
        "predicate": {
          "$ref": "#/$defs/name"
        },
        "subject": {
          "$ref": "#/$defs/tableRef"
        }
      },
      "required": [
        "as_of",
        "predicate",
        "subject"
      ],
      "type": "object"
    },
    "requested_authority": {
      "additionalProperties": false,
      "properties": {
        "connectors": {
          "items": {
            "$ref": "#/$defs/connectorAuthority"
          },
          "minItems": 1,
          "type": "array"
        },
        "model_context": {
          "$ref": "#/$defs/modelContext"
        },
        "mutations": {
          "items": {
            "$ref": "#/$defs/name"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "connectors",
        "model_context",
        "mutations"
      ],
      "type": "object"
    },
    "schema": {
      "const": "inquiry.v0",
      "type": "string"
    },
    "source_policy": {
      "additionalProperties": false,
      "properties": {
        "classes_allowed": {
          "items": {
            "enum": [
              "external_anchor_api",
              "landed_public"
            ],
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "disclosure_ceiling": {
          "$ref": "#/$defs/disclosure"
        }
      },
      "required": [
        "classes_allowed",
        "disclosure_ceiling"
      ],
      "type": "object"
    },
    "universe": {
      "additionalProperties": false,
      "properties": {
        "grain": {
          "$ref": "#/$defs/name"
        },
        "placeholder_identifiers": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "rule": {
          "$ref": "#/$defs/name"
        }
      },
      "required": [
        "grain",
        "placeholder_identifiers",
        "rule"
      ],
      "type": "object"
    }
  },
  "required": [
    "budget",
    "completion",
    "identity_target",
    "lenses",
    "output",
    "question",
    "requested_authority",
    "schema",
    "source_policy",
    "universe"
  ],
  "type": "object",
  "$defs": {
    "blake3Hash": {
      "pattern": "^blake3:[0-9a-f]{64}$",
      "type": "string"
    },
    "budget": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "cost_units": {
          "minimum": 0,
          "type": "integer"
        },
        "human_reviews": {
          "minimum": 0,
          "type": "integer"
        },
        "model_tokens": {
          "minimum": 0,
          "type": "integer"
        },
        "source_calls": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "bytes",
        "cost_units",
        "human_reviews",
        "model_tokens",
        "source_calls"
      ],
      "type": "object"
    },
    "connectorAuthority": {
      "additionalProperties": false,
      "properties": {
        "operations": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "provider": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "operations",
        "provider"
      ],
      "type": "object"
    },
    "disclosure": {
      "const": "public",
      "type": "string"
    },
    "modelContext": {
      "const": "metadata_only",
      "type": "string"
    },
    "output": {
      "additionalProperties": false,
      "properties": {
        "disclosure": {
          "$ref": "#/$defs/disclosure"
        },
        "kind": {
          "$ref": "#/$defs/name"
        }
      },
      "required": [
        "disclosure",
        "kind"
      ],
      "type": "object"
    },
    "name": {
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9._-]*(?::[a-z][a-z0-9._-]*)*$",
      "type": "string"
    },
    "tableRef": {
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9+.-]*://[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$",
      "type": "string"
    }
  }
}
