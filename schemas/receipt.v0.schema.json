{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "domain_disposition": {
            "const": "refusal"
          }
        },
        "required": [
          "domain_disposition"
        ]
      },
      "then": {
        "properties": {
          "execution": {
            "const": "ok"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution": {
            "enum": [
              "cancelled",
              "err",
              "panicked"
            ]
          }
        },
        "required": [
          "execution"
        ]
      },
      "then": {
        "properties": {
          "domain_disposition": {
            "const": "not_applicable"
          }
        }
      }
    }
  ],
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/artifactRef"
      },
      "type": "array"
    },
    "claim_state": {
      "enum": [
        "conflicted",
        "contradicted",
        "forced",
        "supported",
        "unresolved"
      ]
    },
    "code": {
      "type": [
        "string",
        "null"
      ]
    },
    "context": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "node"
            },
            "node_id": {
              "minLength": 1,
              "type": "string"
            },
            "run_id": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "kind",
            "node_id",
            "run_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "standalone"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "coverage": {
      "enum": [
        "complete",
        "partial",
        "unattempted"
      ]
    },
    "domain_disposition": {
      "enum": [
        "negative",
        "not_applicable",
        "positive",
        "refusal"
      ]
    },
    "execution": {
      "enum": [
        "cancelled",
        "err",
        "ok",
        "panicked"
      ]
    },
    "message": {
      "type": "string"
    },
    "observed_at": {
      "type": "string"
    },
    "schema": {
      "const": "receipt.v0"
    }
  },
  "required": [
    "artifacts",
    "claim_state",
    "code",
    "context",
    "coverage",
    "domain_disposition",
    "execution",
    "message",
    "observed_at",
    "schema"
  ],
  "type": "object",
  "$defs": {
    "artifactRef": {
      "pattern": "^artifact:blake3:[0-9a-f]{64}$",
      "type": "string"
    }
  }
}
